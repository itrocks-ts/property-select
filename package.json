{
	"author": {
		"name": "Baptiste Pillot",
		"email": "baptiste@pillot.fr"
	},
	"description": "Interactive property selection through business object relationships",
	"devDependencies": {
		"@itrocks/prepare-module": "latest",
		"sass": "^1.95",
		"typescript": "^6.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./property-select.d.ts",
			"import": "./property-select.js",
			"require": "./cjs/property-select.js"
		},
		"./front/property-select.css": "./front/property-select.css",
		"./front/property-select.html": "./front/property-select.html",
		"./front/property-select.js": {
			"types": "./front/property-select.d.ts",
			"default": "./front/property-select.js"
		},
		"./property-select.js": {
			"types": "./property-select.d.ts",
			"default": "./property-select.js"
		}
	},
	"files": [
		"COPYING",
		"LICENSE",
		"README.md",
		"cjs/*.d.ts",
		"cjs/*.js",
		"front",
		"/*.d.ts",
		"/*.js",
		"!*.map"
	],
	"homepage": "https://it.rocks",
	"keywords": [
		"browser",
		"drag-and-drop",
		"it.rocks",
		"metadata",
		"navigation",
		"property",
		"property-path",
		"relations",
		"search",
		"selection"
	],
	"license": "LGPL-3.0-or-later",
	"name": "@itrocks/property-select",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/property-select.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.front.json && node ../prepare-module/prepare-module.js .browser && sass --no-source-map src/front/property-select.scss:front/property-select.css && node scripts/browser-assets.mjs",
		"test": "npm run build && tsc -p test/tsconfig.json && node --test --test-isolation=none test/*.test.mjs"
	},
	"version": "0.12.5"
}
